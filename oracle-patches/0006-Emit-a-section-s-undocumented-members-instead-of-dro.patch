From a35e6095e2b882940a7d3987956d0f298160f45b Mon Sep 17 00:00:00 2001
From: Ivan Vaitusionak <170527310+ivan-vaitusionak-rightware@users.noreply.github.com>
Date: Fri, 18 Sep 2026 18:45:03 +0200
Subject: [PATCH] Emit a section's undocumented members instead of dropping
 them (#13)

Ported from luadox PR #13 (branch luals-section-members, b578803), which sits on a
different point of the fork's lineage than origin/luals-all does, so it is applied
here as a patch rather than merged.

A name assigned inside an explicit @section is a member of it whether or not it
carries a doc comment, the same way an @enum's membership already follows the
constructor assignment.  luadox dropped the undocumented ones, so a property or
message type whose C++ tooltip is missing disappeared from the rendered page rather
than appearing without a description.  In the production Lua API that silently hid 35
property and message types across 10 pages.

Two things keep the rule from sweeping in code: a section stays open to the end of
the file, so a member must be written as <collection>.<name> -- that excludes a
local in a later function body (ret = ...); and a __-prefixed name is a metamethod
by convention, so __index is not swept in undocumented.

The members are reported under undocumented-section-members, so a project can accept
them with allow_incomplete while still rendering them.

The upstream commit writes `&lt;collection&gt;.&lt;name&gt;` in that comment -- HTML
escapes that landed in Python source.  Written as plain angle brackets here; the
behaviour is identical.
---
 luadox/diagnostics.py |  3 ++-
 luadox/parse.py       | 37 ++++++++++++++++++++++++++++---------
 2 files changed, 30 insertions(+), 10 deletions(-)

diff --git a/luadox/diagnostics.py b/luadox/diagnostics.py
index a532ace..7dd4d21 100644
--- a/luadox/diagnostics.py
+++ b/luadox/diagnostics.py
@@ -45,7 +45,8 @@ class Diagnostics:
     """
 
     CATEGORIES = frozenset({'snippets', 'types', 'untyped', 'references', 'conflicts',
-                            'structure', 'undocumented-enum-members'})
+                            'structure', 'undocumented-enum-members',
+                            'undocumented-section-members'})
 
     def __init__(self, allowed: Set[str]):
         self.allowed = allowed
diff --git a/luadox/parse.py b/luadox/parse.py
index 34e3a0b..5c14b88 100644
--- a/luadox/parse.py
+++ b/luadox/parse.py
@@ -539,21 +539,40 @@ class Parser:
                         requires.append(m.group(1))
 
                     if ref is None:
-                        # Inside an @enum, a name assigned in the constructor is a real member
-                        # of the closed enumeration even without a doc comment: enum sources are
-                        # autogenerated from C++ enumerators, whose Doxygen comments are often
-                        # absent, so membership follows the assignment (as it does in C++), not
-                        # the documentation.  Emit it as a value-only field so it isn't silently
-                        # dropped -- a plain @table would skip an undocumented field here.
-                        enum_scope = scopes[-1]
-                        if isinstance(enum_scope, TableRef) and enum_scope.flags.get('enum'):
+                        # A name assigned inside an @enum or an explicit @section is a member of
+                        # it even without a doc comment.  Both are declared memberships: the enum
+                        # mirrors a C++ enumeration, and a section names the group it contains.
+                        # Their sources are usually autogenerated from C++, whose Doxygen comments
+                        # are often absent, so membership follows the assignment rather than the
+                        # documentation.  Emit it as a value-only field, and report it, so an
+                        # undocumented member is visible in the output instead of disappearing
+                        # from it -- a plain @table still skips an undocumented field.
+                        member_scope = scopes[-1]
+                        in_enum = (isinstance(member_scope, TableRef)
+                                   and member_scope.flags.get('enum'))
+                        in_section = isinstance(collection, SectionRef)
+                        if in_enum or in_section:
                             name, value = self._parse_field(line)
-                            if name:
+                            # A section stays open to the end of the file, so an assignment in a
+                            # later function body sits inside it too.  A member is written as
+                            # `<collection>.<name>`; a local (`ret = ...`) is not, which is what
+                            # separates the two without reading the code's structure.
+                            qualified = bool(name) and name.startswith('{}.'.format(member_scope.name))
+                            # A `__`-prefixed name is a metamethod or internal by Lua convention
+                            # (`__index`), so it is not swept in undocumented; documenting one
+                            # explicitly still emits it, as it always did.
+                            internal = bool(name) and name.rsplit('.', 1)[-1].startswith('__')
+                            if name and not internal and (in_enum or qualified):
                                 field = FieldRef(
                                     self.refs, file=path, line=n, scopes=scopes[:],
                                     symbol=name, collection=collection, value=value,
                                     diagnostics=self.diagnostics)
                                 self._add_reference(field, modref)
+                                if in_section:
+                                    self.diagnostics.add(
+                                        'undocumented-section-members',
+                                        '{} has no doc comment'.format(name),
+                                        path, n)
                         continue
 
                     # The second parse result is the argument list for a function
-- 
