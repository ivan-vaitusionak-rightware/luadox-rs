Date: Thu, 17 Sep 2026 08:55:03 +0200
Subject: [PATCH 2/5] Report undocumented @enum members under a granular
 undocumented-enum-members category (#11)

(cherry picked from commit 873cfb28a2cdb693512175b58cc5d1bbc04d3e35)
---
 README.md             | 23 ++++++++++++++---------
 luadox/diagnostics.py |  3 ++-
 luadox/parse.py       | 31 ++++++++++++++++++++++++++-----
 3 files changed, 42 insertions(+), 15 deletions(-)

diff --git a/README.md b/README.md
index f498663..fe813ac 100644
--- a/README.md
+++ b/README.md
@@ -417,10 +417,12 @@ closed-enum value.  The bundled renderers show each member's value (in the HTML
 beside the member name, and carried in the json/yaml output); a renderer with a native
 enumeration representation can additionally treat membership as closed.
 
-Because a closed enumeration is only meaningful when every member is an integer constant,
-LuaDox reports a `structure` diagnostic for an `@enum` that has no members with an integer
-value (for example, the tag placed on something that isn't an integer table) and for any
-member not assigned an integer value.
+Membership follows the assignment, not the documentation -- an undocumented member is still
+emitted (value only), so autogenerated enums whose C++ enumerators lack comments aren't
+dropped.  Each undocumented member is reported under its own `undocumented-enum-members`
+diagnostic category, so a project whose enums are generated can accept them with
+`allow_incomplete = undocumented-enum-members` without relaxing any other check.  An `@enum`
+can't nest a `@table`/`@enum`, and a duplicate member is a conflict.
 
 ### `@deprecated`
 
@@ -1229,11 +1231,14 @@ The categories currently defined are:
    determined -- so one of them is dropped or orphaned.
 * `structure`: a documentation block is malformed -- an unrecognized or malformed tag,
    a comment block not connected to any section, an element defined before the previous
-   block terminated, or an `@order` without an anchor -- so content is ignored or
-   attached to the wrong element.
-* `untyped`: a function parameter present in the signature has no documented type
-   (`luals` renderer only), so it can only be rendered as `any`.  Undocumented return
-   types are not reported, being indistinguishable from a function that returns nothing.
+   block terminated, an `@order` without an anchor, or a malformed `@enum` (empty, or with
+   a non-integer or nested member) -- so content is ignored or attached to the wrong
+   element.
+* `untyped`: a function parameter has no `@tparam` documenting it.
+* `undocumented-enum-members`: an `@enum` member has no doc comment.  Reported per member,
+   whether the rest of the enum is documented or not -- common for autogenerated enums whose
+   C++ enumerators carry no comment -- and kept separate from `structure` so it can be
+   accepted on its own without loosening any other check.
 
 Only these categories feed the exit code.  Other problems LuaDox reports are logged
 but don't affect it.
diff --git a/luadox/diagnostics.py b/luadox/diagnostics.py
index ddae2e9..e78bcce 100644
--- a/luadox/diagnostics.py
+++ b/luadox/diagnostics.py
@@ -42,7 +42,8 @@ class Diagnostics:
     line), which downgrades its reports to warnings.
     """
 
-    CATEGORIES = frozenset({'snippets', 'types', 'untyped', 'references', 'conflicts', 'structure'})
+    CATEGORIES = frozenset({'snippets', 'types', 'untyped', 'references', 'conflicts',
+                            'structure', 'undocumented-enum-members'})
 
     def __init__(self, allowed: Set[str]):
         self.allowed = allowed
diff --git a/luadox/parse.py b/luadox/parse.py
index ac9b361..c1c35bc 100644
--- a/luadox/parse.py
+++ b/luadox/parse.py
@@ -593,11 +593,25 @@ class Parser:
 
     def validate_enums(self) -> None:
         """
-        Reports @enum tables that can't form a closed enumeration: those with no
-        members (e.g. the tag landed on something that isn't an integer table), and
-        members not assigned an integer value.  A closed enumeration needs every
-        member to carry an integer constant (mirroring a C++ enumerator) so
-        renderers with a native enum representation can treat membership as closed.
+        Reports @enum tables that can't form a closed enumeration.  Membership mirrors a
+        C++ enum: a member exists because it is assigned a value in the constructor, not
+        because it is documented -- enum sources are autogenerated and many enumerators
+        carry no doc comment.  Every member, documented or not, is emitted, so a renderer
+        with a native enum representation can treat membership as closed.
+
+        Whether a member is documented is the source's to decide: an undocumented member
+        is not malformed, just undocumented, so each one is reported at its own location
+        under the granular `undocumented-enum-members` category rather than under a generic
+        `undocumented` category or promoted to a `structure` error.  A project whose enums
+        are autogenerated -- the C++ enumerators often carrying no comment -- can then accept
+        `allow_incomplete = undocumented-enum-members` without loosening any other check, and
+        a partly documented enum no longer forces an all-or-nothing choice.
+
+        We still report as `structure` an @enum with no members at all (the tag landed on
+        something that isn't a table of integer constants) and any member not assigned an
+        integer literal, because those are malformed rather than merely undocumented.
+        A member assigned twice surfaces as a `conflicts` diagnostic when it is added, and
+        a nested @table/@enum is rejected during parsing.
         """
         for colref in self.parsed[TableRef]:
             if not colref.flags.get('enum'):
@@ -615,6 +629,13 @@ class Parser:
                     colref.file, colref.line)
                 continue
             for member in members:
+                # A member is documented iff it carried a doc comment (raw_content); a
+                # value-only member synthesized from a bare assignment has none.
+                if not member.raw_content:
+                    self.diagnostics.add(
+                        'undocumented-enum-members',
+                        '@enum member {} has no doc comment'.format(member.name),
+                        member.file, member.line)
                 if not is_integer_literal(member.value):
                     self.diagnostics.add(
                         'structure',
